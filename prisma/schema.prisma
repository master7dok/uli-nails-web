// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Service {
  id            String   @id @default(cuid())
  category      String   @default("manicure") // manicure, gel, extension, additional
  titlePl       String
  titleUa       String
  descriptionPl String?
  descriptionUa String?
  pricePln      Float
  durationMin   Int?     @default(90)
  isPopular     Boolean  @default(false)
  sortOrder     Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model Course {
  id            String   @id @default(cuid())
  slug          String   @unique
  titlePl       String
  titleUa       String
  subtitlePl    String?
  subtitleUa    String?
  descriptionPl String
  descriptionUa String
  durationPl    String   @default("2 dni")
  durationUa    String   @default("2 дні")
  levelPl       String   @default("Dla każdego")
  levelUa       String   @default("Для всіх")
  pricePln      Float
  badgePl       String?
  badgeUa       String?
  bonusPl       String?
  bonusUa       String?
  featuresPl    String   // JSON string array
  featuresUa    String   // JSON string array
  syllabusPl    String?  // JSON string array of days
  syllabusUa    String?  // JSON string array of days
  formUrl       String?
  sortOrder     Int      @default(0)
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model PortfolioItem {
  id             String   @id @default(cuid())
  imageUrl       String
  titlePl        String?
  titleUa        String?
  category       String   @default("gel") // gel, manicure, french, correction
  objectPosition String?  @default("center") // e.g. "center", "center top", "center bottom", or "50% 25%"
  featured       Boolean  @default(false)
  sortOrder      Int      @default(0)
  createdAt      DateTime @default(now())
}

model Testimonial {
  id        String   @id @default(cuid())
  name      String
  rolePl    String
  roleUa    String
  textPl    String
  textUa    String
  rating    Int      @default(5)
  avatarUrl String?
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
}

model Setting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

model TrainingPhoto {
  id             String   @id @default(cuid())
  imageUrl       String
  titlePl        String?
  titleUa        String?
  category       String   @default("process") // process, students, certificates, practice
  objectPosition String?  @default("center") // e.g. "center", "center top", "center bottom", or "50% 25%"
  featured       Boolean  @default(false)
  sortOrder      Int      @default(0)
  createdAt      DateTime @default(now())
}

model LeadMagnet {
  id            String          @id @default(cuid())
  fileUrl       String          @default("")
  fileName      String?
  fileSize      String?
  fileUrlUa     String?
  fileNameUa    String?
  fileSizeUa    String?
  fileUrlPl     String?
  fileNamePl    String?
  fileSizePl    String?
  titlePl       String
  titleUa       String
  descriptionPl String?
  descriptionUa String?
  badgePl       String?         @default("Darmowy PDF")
  badgeUa       String?         @default("Безкоштовний PDF")
  buttonTextPl  String?         @default("Pobierz Checklist")
  buttonTextUa  String?         @default("Отримати чек-лист")
  coverUrl      String?
  downloadCount Int             @default(0)
  sortOrder     Int             @default(0)
  isActive      Boolean         @default(true)
  leads         ChecklistLead[]
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
}

model ChecklistLead {
  id             String      @id @default(cuid())
  leadMagnetId   String?
  leadMagnet     LeadMagnet? @relation(fields: [leadMagnetId], references: [id], onDelete: SetNull)
  checklistTitle String
  instagram      String
  email          String
  experience     String
  language       String      @default("ua")
  type           String      @default("checklist") // "checklist" | "video"
  createdAt      DateTime    @default(now())
}

model BonusVideo {
  id            String    @id @default(cuid())
  videoUrlUa    String?
  videoUrlPl    String?
  titleUa       String
  titlePl       String
  descriptionUa String?
  descriptionPl String?
  badgeUa       String?   @default("Безкоштовний відеоурок")
  badgePl       String?   @default("Darmowa lekcja wideo")
  buttonTextUa  String?   @default("Дивитися відео")
  buttonTextPl  String?   @default("Oglądaj wideo")
  coverUrl      String?
  duration      String?
  viewsCount    Int       @default(0)
  sortOrder     Int       @default(0)
  isActive      Boolean   @default(true)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}


